# DRHPLens — environment variable template
# Copy to .env and fill in your own values.
# NEVER commit .env with real values — only commit this .env.example.
# On HF Spaces, add these via the Spaces secrets UI (not as files).

# LLM provider for generation: groq (default, big free tier) | gemini (fallback)
LLM_PROVIDER=groq

# Groq API key — DEFAULT generation provider (free tier — https://console.groq.com/keys)
GROQ_API_KEY=

# Gemini API key — fallback provider; set LLM_PROVIDER=gemini to use (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Qdrant Cloud cluster URL and API key
# Free 1GB cluster at https://cloud.qdrant.io/
QDRANT_URL=
QDRANT_API_KEY=

# Langfuse observability (free cloud tier — https://cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse host — EU cloud default; use https://us.cloud.langfuse.com if you signed up in US region
LANGFUSE_HOST=https://cloud.langfuse.com
